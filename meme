Features["InfiniteFly"] = function(on)
	-- vuelo libre: W/S sube/baja, la cámara dirige el movimiento
	if on then
		local uis = game:GetService("UserInputService")
		local move = Vector3.zero
		local keys = {
			[Enum.KeyCode.W] = "F", [Enum.KeyCode.S] = "B",
			[Enum.KeyCode.A] = "L", [Enum.KeyCode.D] = "R",
			[Enum.KeyCode.Space] = "U", [Enum.KeyCode.LeftControl] = "D",
		}
		local list = {}
		list[#list + 1] = uis.InputBegan:Connect(function(i, gp)
			if gp then return end
			if keys[i.KeyCode] then
				if keys[i.KeyCode] == "F" then move = Vector3.new(0, 0, -1)
				elseif keys[i.KeyCode] == "B" then move = Vector3.new(0, 0, 1)
				elseif keys[i.KeyCode] == "L" then move = Vector3.new(-1, 0, 0)
				elseif keys[i.KeyCode] == "R" then move = Vector3.new(1, 0, 0)
				elseif keys[i.KeyCode] == "U" then move = Vector3.new(0, 1, 0)
				else move = Vector3.new(0, -1, 0) end
			end
		end)
		list[#list + 1] = uis.InputEnded:Connect(function(i)
			if keys[i.KeyCode] then move = Vector3.zero end
		end)
		stop("fly")
		conns["fly"] = list
		eachFrame("flyloop", function(dt)
			local r, h = root(), hum()
			if not r then return end
			if move.Magnitude > 0 then
				local cam = workspace.CurrentCamera
				local cf = cam.CFrame
				local dir
				if move.Z ~= 0 then dir = cf.LookVector * move.Z
				elseif move.X ~= 0 then dir = cf.RightVector * move.X
				else dir = Vector3.new(0, move.Y, 0) end
				r.CFrame = r.CFrame + dir.Unit * 60 * dt
			end
			if h then
				h.PlatformStand = move.Magnitude > 0
				if move.Magnitude > 0 then
					r.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end)
	else
		stop("fly")
		stop("flyloop")
		local h = hum()
		if h then h.PlatformStand = false end
	end
end

