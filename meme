-- [meyy:192] hideGeometry(): geometría opaca, sin reflectancia ni sombras
local function applyHideGeometry(inst)
	if not inst:IsA("BasePart") then return end
	if inst.Transparency == 1 then return end   -- hitbox invisible: se respeta
	saveGfx(inst, {"Material", "Reflectance", "CastShadow"})
	if inst.CastShadow ~= false then inst.CastShadow = false end
	if inst.Reflectance ~= 0 then inst.Reflectance = 0 end
	if inst.Material ~= Enum.Material.Plastic then
		inst.Material = Enum.Material.Plastic
	end
end

-- [meyy:211] cull(): mata partículas, rastros y luces del mapa
local function applyCull(inst)
	if inst:IsA("ParticleEmitter") then
		saveGfx(inst, {"Enabled", "Rate"})
		inst.Rate = 0
		inst.Enabled = false
	elseif inst:IsA("Beam") or inst:IsA("Trail") then
		saveGfx(inst, {"Enabled"})
		inst.Enabled = false
	elseif inst:IsA("PointLight") or inst:IsA("SpotLight")
		or inst:IsA("SurfaceLight") then
		saveGfx(inst, {"Enabled"})
		inst.Enabled = false
	elseif inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
		saveGfx(inst, {"Enabled"})
		inst.Enabled = false
	end
end

