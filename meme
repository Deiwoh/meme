-- [DevxBananaCat.lua:20758] ClosestPartaimbot()
-- enemigo vivo más cercano (devuelve su modelo)
local function closestEnemy()
	local r = root()
	if not r then return nil end
	local best, bestD = nil, math.huge
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= player then
			local c = pl.Character
			local hrp = c and c:FindFirstChild("HumanoidRootPart")
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if hrp and h and h.Health > 0 then
				local d = (r.Position - hrp.Position).Magnitude
				if d < bestD then best, bestD = c, d end
			end
		end
	end
	return best
end

-- [cracked (1).txt:3376] NPCPos()  →  NPC vivo más cercano
local function nearestNPC()
	local r = root()
	if not r then return nil end
	local best, bestD, bestPart = nil, math.huge, nil
	for _, m in ipairs(workspace:GetChildren()) do
		if m:IsA("Model") and m ~= char() and not Players:GetPlayerFromCharacter(m) then
			local h = m:FindFirstChildOfClass("Humanoid")
			local p = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
			if h and p and h.Health > 0 then
				local d = (r.Position - p.Position).Magnitude
				if d < bestD then best, bestD, bestPart = m, d, p end
			end
		end
	end
	return best, bestPart
end

-- tween suave del HumanoidRootPart al CFrame dado
local function tweenRoot(key, goal, dur)
	stop(key)
	local r = root()
	if not r then return false end
	local info = TweenInfo.new(dur or 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tw = TweenService:Create(r, info, {CFrame = goal})
	conns[key] = {tw.Completed:Connect(function() end)}
	tw:Play()
	return true
end

