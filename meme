-- [AutoBounty-FULLMeyyhub.lua:3728] FindDamageText():
--  recorre el contador de daño del HUD (PlayerGui.Main.DmgCounter) y
--  devuelve el primer número que encuentra en los TextLabel.
local function findDamageText(element)
	if element:IsA("TextLabel") or element:IsA("TextButton")
		or element:IsA("TextBox") then
		local numStr = string.gsub(element.Text or "", "[^%d]", "")
		local damageValue = tonumber(numStr)
		if damageValue then return damageValue end
	end
	for _, child in ipairs(element:GetChildren()) do
		local found = findDamageText(child)
		if found then return found end
	end
	return nil
end

