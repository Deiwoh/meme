-- el barco más cercano y su asiento
local function nearestBoat()
	local r = root()
	if not r then return nil, nil end
	local best, bestD, bestSeat = nil, math.huge, nil
	local conts = {workspace}
	local b = workspace:FindFirstChild("Boats")
	if b then conts[#conts + 1] = b end
	for _, cont in ipairs(conts) do
		for _, m in ipairs(cont:GetChildren()) do
			if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
				local seat = m:FindFirstChildWhichIsA("VehicleSeat", true)
					or m:FindFirstChild("VehicleSeat", true)
				if seat then
					local d = (r.Position - seat.Position).Magnitude
					if d < bestD then best, bestD, bestSeat = m, d, seat end
				end
			end
		end
	end
	return best, bestSeat
end

