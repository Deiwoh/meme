-- Modelos vivos (no jugadores) a menos de `radius` studs del personaje.
-- Equivalente a los `workspace.Enemies:GetChildren()` de tus sources.
local function enemyPartsIn(radius)
	local out = {}
	local r = root()
	if not r then return out end
	local conts = {workspace}
	local en = workspace:FindFirstChild("Enemies")
	if en then conts[#conts + 1] = en end
	for _, cont in ipairs(conts) do
		for _, m in ipairs(cont:GetChildren()) do
			if m:IsA("Model") and m ~= char()
				and not Players:GetPlayerFromCharacter(m) then
				local h = m:FindFirstChildOfClass("Humanoid")
				local p = m:FindFirstChild("HumanoidRootPart")
				if h and p and h.Health > 0 then
					local d = (r.Position - p.Position).Magnitude
					if d <= radius then out[#out + 1] = p end
				end
			end
		end
	end
	return out
end

